{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QuestionReadOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:243112136765:table/Question"
    },
    {
      "Sid": "ScoreAndGuestbookWriteQuery",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:243112136765:table/Score",
        "arn:aws:dynamodb:ap-northeast-2:243112136765:table/Guestbook"
      ]
    }
  ]
}
